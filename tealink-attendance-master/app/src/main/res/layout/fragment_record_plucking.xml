<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
            android:id="@+id/weighment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:overlapAnchor="false" />

        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
            android:id="@+id/section_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/weighment"
            android:layout_marginBottom="12dp" />

        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
            android:id="@+id/batch_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/section_spinner"
            android:layout_marginBottom="12dp" />

        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
            android:id="@+id/shift_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/batch_spinner"
            android:layout_marginBottom="12dp" />

        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
            android:id="@+id/kamjari_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/shift_spinner"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/select_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/kamjari_spinner"
            android:drawableRight="@drawable/round_navigate_next_white_24dp"
            android:text="@string/next"
            android:theme="@style/Button" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/device_name_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/select_section">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/device_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="@string/weighing_scale_name"
                android:imeActionLabel="@string/weighing_scale_name"
                android:inputType="textNoSuggestions"
                android:textColor="@color/colorPrimaryDark" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/device_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/device_name_input_container"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/connect_disconnect_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/device_list"
            android:drawableRight="@drawable/round_navigate_next_white_24dp"
            android:text="@string/connect_scale"
            android:theme="@style/Button" />

        <TextView
            android:id="@+id/processedWorkerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="20dip"
            android:paddingLeft="10dip"
            android:textColor="@color/colorAccent"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/processedWorkerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/processedWorkerCount"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="20dip"
            android:layout_toEndOf="@id/processedWorkerCount"
            android:paddingLeft="7dip"
            android:text="@string/worker_s_processed"
            android:textColor="@color/colorAccent"
            android:textSize="23sp" />

        <ImageView
            android:id="@+id/worker_image"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_alignParentRight="true"
            android:layout_marginRight="10dp"
            android:paddingBottom="20dp"
            android:src="@drawable/person_placeholder" />

        <TextView
            android:id="@+id/worker_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toLeftOf="@id/worker_image"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/worker_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_name"
            android:layout_marginLeft="10dp"
            android:layout_toLeftOf="@id/worker_image"
            android:paddingTop="20dp"
            android:textColor="@color/colorPrimaryDark" />

        <TextView
            android:id="@+id/total_weighment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_image"
            android:paddingLeft="20dp"
            android:paddingTop="20dp"
            android:paddingRight="20dp"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/total_weighment_breakup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/total_weighment"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp"
            android:textColor="@color/black" />

        <View
            android:id="@+id/separator"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_below="@id/total_weighment_breakup" />

        <TextView
            android:id="@+id/weighted_quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/separator"
            android:gravity="center"
            android:padding="10px"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="34sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/worker_img_capture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/weighted_quantity"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:drawableRight="@drawable/round_perm_camera_white_24dp"
            android:text="@string/identify_user_capture"
            android:theme="@style/Button" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/identify_worker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_img_capture"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:drawableRight="@drawable/round_perm_identity_white_24dp"
            android:text="@string/identify_user_newline"
            android:theme="@style/Button" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/select_worker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/manually_select_worker"
            android:theme="@style/Button" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/worker_code_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/select_worker">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/worker_code_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="@string/worker_code"
                android:imeActionLabel="@string/worker_code"
                android:inputType="textNoSuggestions"
                android:textColor="@color/colorPrimaryDark" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/selectedScaleValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/black"
            android:textSize="26sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/nfc_card_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/worker_code_input_container"
            android:src="@drawable/identify" />

    </RelativeLayout>

</ScrollView>