<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:paddingBottom="10dp"
        android:paddingTop="10dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:id="@+id/worker_image"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_alignParentRight="true"
            android:layout_marginRight="10dp"
            android:src="@drawable/person_placeholder" />

        <TextView
            android:id="@+id/worker_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toLeftOf="@id/worker_image"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/worker_emp_no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_name"
            android:layout_marginLeft="10dp"
            android:layout_toLeftOf="@id/worker_image"
            android:paddingTop="20dp"
            android:textColor="@color/colorPrimaryDark" />

        <TextView
            android:id="@+id/worker_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_emp_no"
            android:layout_marginLeft="10dp"
            android:layout_toLeftOf="@id/worker_image"
            android:paddingTop="10dp"
            android:textColor="@color/colorPrimaryDark" />

        <TextView
            android:id="@+id/worker_weighments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_code"
            android:layout_marginLeft="10dp"
            android:layout_toLeftOf="@id/worker_image"
            android:paddingTop="10dp"
            android:textColor="@color/colorPrimaryDark" />

        <RelativeLayout
            android:id="@+id/action_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_image"
            android:padding="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/update_kamjari"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_kamjari"
                android:theme="@style/Button" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/update_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/update_kamjari"
                android:text="@string/update_section"
                android:theme="@style/Button" />
        </RelativeLayout>

        <TextView
            android:id="@+id/worker_book_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/action_container"
            android:layout_marginLeft="5dp"
            android:text="@string/worker_book"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/worker_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_book_container"
            android:layout_marginBottom="7dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/mock_edittext_border"
            android:paddingLeft="0dp"
            android:textColor="@color/black_light"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/worker_type_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_book"
            android:layout_marginLeft="5dp"
            android:text="@string/worker_type"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/worker_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_type_container"
            android:layout_marginBottom="7dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/mock_edittext_border"
            android:paddingLeft="0dp"
            android:textColor="@color/black_light"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/worker_subtype_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_type"
            android:layout_marginLeft="5dp"
            android:text="@string/worker_subtype"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/worker_subtype"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_subtype_container"
            android:layout_marginBottom="7dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/mock_edittext_border"
            android:paddingLeft="0dp"
            android:textColor="@color/black_light"
            android:textSize="18sp" />

        <TextView
            android:visibility="gone"
            android:id="@+id/worker_kamjari_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_subtype"
            android:layout_marginLeft="5dp"
            android:text="@string/worker_kamjari"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <TextView
            android:visibility="gone"
            android:id="@+id/worker_kamjari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_kamjari_container"
            android:layout_marginBottom="7dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/mock_edittext_border"
            android:paddingLeft="0dp"
            android:textColor="@color/black_light"
            android:textSize="18sp" />

        <TextView
            android:visibility="gone"
            android:id="@+id/worker_section_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_kamjari"
            android:layout_marginLeft="5dp"
            android:text="@string/worker_section"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <TextView
            android:visibility="gone"
            android:id="@+id/worker_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/worker_section_container"
            android:layout_marginBottom="7dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/mock_edittext_border"
            android:paddingLeft="0dp"
            android:textColor="@color/black_light"
            android:textSize="18sp" />
    </RelativeLayout>
</ScrollView>
